FROM segment-any-tree:pandasfix

# The upstream image has an incompatible scientific stack:
#   numpy 1.24.x with scipy 1.5.x, which can break scikit-learn binary modules.
# Reinstall a compatible set of wheels for Python 3.8.
RUN pip3 uninstall -y numpy scipy scikit-learn sklearn || true \
    && pip3 install --no-cache-dir --upgrade --force-reinstall \
        'numpy==1.24.4' \
        'scipy==1.10.1' \
        'scikit-learn==1.2.2'

COPY run_oracle_pipeline.sh /home/nibio/mutable-outside-world/run_oracle_pipeline.sh
RUN chmod +x /home/nibio/mutable-outside-world/run_oracle_pipeline.sh
