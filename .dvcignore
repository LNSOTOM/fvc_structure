# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# repo / env
.git/
.dvc/
.venv/
venv/
env/
__pycache__/

# large vendor/outputs not meant for DVC tracking here
libs/
libnabo/
node_modules/
dist/

# NOTE:
# Do not ignore `ForestFormer3D/data/ForAINetV2/` because the DVC pipeline
# stages in `dvc.yaml` track outputs under this directory (e.g.
# `forainetv2_instance_data`, `points`, `instance_mask`, etc.).